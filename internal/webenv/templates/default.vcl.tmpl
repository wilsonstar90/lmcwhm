vcl 4.1;
# Generated by lmcwhm — do not edit; changes are overwritten on every apply.
# HAProxy -> Varnish (here) -> nginx. Logged-in users, POSTs, admin pages and
# responses that set cookies or say private / no-store are never cached.

import std;

backend nginx {
    .host = "127.0.0.1";
    .port = "{{.NginxPort}}";
    .connect_timeout = 5s;
    .first_byte_timeout = 300s;
    .between_bytes_timeout = 60s;
}

acl purgers {
    "127.0.0.1";
    "::1";
}

sub vcl_recv {
    set req.http.host = std.tolower(regsub(req.http.host, ":[0-9]+$", ""));
    if (req.method == "PURGE") {
        if (client.ip !~ purgers) {
            return (synth(405, "Not allowed"));
        }
        return (purge);
    }
    if (req.method != "GET" && req.method != "HEAD") {
        return (pass);
    }
    if (req.http.Authorization || req.http.Upgrade ~ "(?i)websocket") {
        return (pass);
    }
    if (req.url ~ "^/(wp-admin|wp-login\.php|wp-cron\.php|wp-json|xmlrpc\.php|admin|administrator|user|login|logout|cart|checkout|my-account|phpmyadmin)") {
        return (pass);
    }
{{- range .Sites}}{{if .NoCache}}
    if (({{hostcond "req.http.host" .Hosts}}) && req.url ~ "{{.NoCache}}") {
        return (pass);
    }
{{- end}}{{end}}
    if (req.http.Cookie ~ "(wordpress_logged_in|wp-postpass|woocommerce_items_in_cart|woocommerce_cart_hash|comment_author|PHPSESSID|laravel_session|XSRF-TOKEN)") {
        return (pass);
    }
    if (req.url ~ "\.(css|js|mjs|png|jpe?g|gif|ico|svg|webp|avif|woff2?|ttf|otf|eot|mp4|webm|mp3|pdf)(\?.*)?$") {
        unset req.http.Cookie;
    } elsif (req.http.Cookie) {
        # Analytics cookies do not change the page.
        set req.http.Cookie = regsuball(req.http.Cookie, "(^|;\s*)(_ga[^=]*|_gid|_gat[^=]*|_fbp|_gcl_[a-z]+|__utm[a-z]+|_hj[^=]*)=[^;]*", "");
        set req.http.Cookie = regsub(req.http.Cookie, "^[;\s]+", "");
        if (req.http.Cookie == "") {
            unset req.http.Cookie;
        }
    }
    return (hash);
}

sub vcl_hash {
    # http:// pages may be redirects; keep them apart from https://.
    hash_data(req.http.X-Forwarded-Proto);
}

sub vcl_backend_response {
    if (beresp.http.Set-Cookie || beresp.http.Cache-Control ~ "(private|no-cache|no-store)" || beresp.status >= 500) {
        set beresp.uncacheable = true;
        set beresp.ttl = 120s;
        return (deliver);
    }
    if (beresp.http.Cache-Control !~ "(s-)?max-age" && !beresp.http.Expires) {
        set beresp.ttl = 120s;
{{- range .Sites}}
        if ({{hostcond "bereq.http.host" .Hosts}}) {
            set beresp.ttl = {{.TTL}}s;
        }
{{- end}}
    }
    set beresp.grace = 1h;
}

sub vcl_deliver {
    if (obj.hits > 0) {
        set resp.http.X-Cache = "HIT";
    } else {
        set resp.http.X-Cache = "MISS";
    }
    unset resp.http.Via;
    unset resp.http.X-Varnish;
}

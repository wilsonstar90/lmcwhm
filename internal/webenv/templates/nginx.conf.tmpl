# Generated by lmcwhm — do not edit.
{{- if .WAF}}
load_module /etc/nginx/modules/ngx_http_modsecurity_module.so;
{{- end}}
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /var/run/nginx.pid;

events {
    worker_connections 4096;
}

http {
    include /etc/nginx/mime.types;
{{- if .WAF}}

    # ModSecurity v3 + OWASP CRS (settings written by the image's entrypoint).
    modsecurity on;
    modsecurity_rules_file /etc/modsecurity.d/setup.conf;
    # The edge sets this on requests the User-Agent / URL white lists allow.
    modsecurity_rules 'SecRule REQUEST_HEADERS:X-Lmcwhm-Pass "@streq 1" "id:9000001,phase:1,pass,nolog,ctl:ruleEngine=Off"';
{{- if .WAFDisabled}}
    # CRS rules switched off for every site (Security → WAF → OWASP rules).
    modsecurity_rules 'SecRuleRemoveById {{.WAFDisabled}}';
{{- end}}
{{- end}}
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    client_max_body_size 128m;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # All traffic arrives from the HAProxy edge on loopback.
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    map $http_x_forwarded_proto $fwd_https {
        https on;
        default off;
    }
    map $http_x_forwarded_proto $fwd_proto {
        https https;
        default http;
    }
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # The edge names refusals "<status>:<reason>" (X-Lmcwhm-Block) and matches
    # of rules that only detect (X-Lmcwhm-Detect).
    map $http_x_lmcwhm_block $lmcwhm_block_status {
        "~^(?<code>[0-9]{3}):" $code;
        "" "";
        default 403;
    }
    map $http_x_lmcwhm_block $lmcwhm_block_reason {
        "~^[0-9]{3}:(?<why>.*)$" $why;
        default $http_x_lmcwhm_block;
    }
    log_format main '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent" "$host" "$lmcwhm_block_reason" "$http_x_lmcwhm_detect"';
    access_log /var/log/nginx/access.log main;

    # Unknown hosts.
    server {
        listen 127.0.0.1:{{.NginxPort}} default_server;
        server_name _;
{{- range .ErrorPages}}
        error_page {{.Code}} /__lmcwhm_err/{{.Page}}.html;
{{- end}}
{{- if .ErrorPages}}
        location ^~ /__lmcwhm_err/ {
            internal;
            ssi on;
            alias {{.ErrDir}}/;
        }
{{- end}}
        location / {
            return 404;
        }
    }

    include {{.ConfDir}}/conf.d/*.conf;
}

# Generated by lmcwhm for {{.Domain}} — do not edit.
server {
    listen 127.0.0.1:{{.NginxPort}};
    server_name {{.ServerNames}};
    root {{.Root}};
    index index.php index.html index.htm;

    access_log {{.LogDir}}/{{.Domain}}.log main;
    error_log  {{.LogDir}}/{{.Domain}}.error.log;
{{if .Stopped}}
    location / {
        default_type text/html;
        return 503 "<h1>Site stopped</h1>";
    }
{{else}}
    location ~ /\.(?!well-known) {
        deny all;
    }
{{if .Upstream}}
    location / {
        proxy_pass {{.Upstream}};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_buffering off;
    }
{{else if .PHPPort}}
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass 127.0.0.1:{{.PHPPort}};
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS $fwd_https;
        fastcgi_read_timeout 300;
    }
{{else}}
    location / {
        try_files $uri $uri/ =404;
    }
{{end}}
{{- if not .Upstream}}
    location ~* \.(?:css|js|jpg|jpeg|gif|png|webp|svg|ico|woff2?)$ {
        expires 7d;
        access_log off;
    }
{{- end}}
{{end}}
}

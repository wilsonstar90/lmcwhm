# Generated by lmcwhm for {{.Domain}} — do not edit.
{{- if .Adv.RateLimit}}
limit_req_zone $binary_remote_addr zone={{.ReqZone}}:10m rate={{.Adv.RateLimit}}r/s;
{{- end}}
{{- if .Adv.ConnLimit}}
limit_conn_zone $binary_remote_addr zone={{.ConnZone}}:10m;
{{- end}}
server {
    listen 127.0.0.1:{{.NginxPort}};
    server_name {{.ServerNames}};
    root {{.Root}};
    index index.php index.html index.htm;

    access_log {{.LogDir}}/{{.Domain}}.log main;
    error_log  {{.LogDir}}/{{.Domain}}.error.log;
    # Refused at the edge (blacklists, website protection, dedicated rules);
    # the header names the reason, logged with the request.
    if ($http_x_lmcwhm_block = cc) {
        return 429;
    }
    if ($http_x_lmcwhm_block) {
        return 403;
    }
{{- if .WAFOff}}
    modsecurity off;
{{- else if .WAFExclude}}
    modsecurity_rules 'SecRuleRemoveById {{.WAFExclude}}';
{{- end}}
{{- if .Adv.MaxBodyMB}}
    client_max_body_size {{.Adv.MaxBodyMB}}m;
{{- end}}
{{- range .Adv.DenyIPs}}
    deny {{.}};
{{- end}}
{{- if .Adv.AllowIPs}}
{{- range .Adv.AllowIPs}}
    allow {{.}};
{{- end}}
    deny all;
{{- end}}
{{- if .DenyUA}}
    if ($http_user_agent ~* "{{.DenyUA}}") {
        return 403;
    }
{{- end}}
{{- if .Adv.RateLimit}}
    limit_req zone={{.ReqZone}} burst={{.Adv.RateBurst}} nodelay;
    limit_req_status 429;
{{- end}}
{{- if .Adv.ConnLimit}}
    limit_conn {{.ConnZone}} {{.Adv.ConnLimit}};
    limit_conn_status 429;
{{- end}}
{{- if .Adv.Autoindex}}
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;
{{- end}}
{{- if .Adv.ErrorPages}}
    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;
{{- end}}
{{if .Stopped}}
    location / {
        default_type text/html;
        return 503 "<h1>Site stopped</h1>";
    }
{{else if .Redirect}}
    location / {
        return {{.RedirectCode}} {{.Redirect}}{{if .RedirectPath}}$request_uri{{end}};
    }
{{else}}
    location ~ /\.(?!well-known) {
        deny all;
    }
{{- range .Adv.Redirects}}
    location = {{.From}} {
        return {{.Code}} {{.To}};
    }
{{- end}}
{{- if .Adv.BlockXMLRPC}}
    location = /xmlrpc.php {
        deny all;
    }
{{- end}}
{{if .Upstream}}
    location / {
        proxy_pass {{.Upstream}};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
        proxy_buffering off;
    }
{{else if .PHPPort}}
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass 127.0.0.1:{{.PHPPort}};
        fastcgi_index index.php;
        include /etc/nginx/fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS $fwd_https;
        fastcgi_read_timeout 300;
    }
{{else}}
    location / {
        try_files $uri $uri/ =404;
    }
{{end}}
{{- if not .Upstream}}
{{- if .Adv.Hotlink}}
    location ~* \.(?:jpg|jpeg|gif|png|webp|svg|ico|mp4|webm|mp3|pdf)$ {
        valid_referers none blocked server_names {{range .Adv.Hotlink}}{{.}} {{end}};
        if ($invalid_referer) {
            return 403;
        }
        expires 7d;
        access_log off;
    }
{{- end}}
    location ~* \.(?:css|js|jpg|jpeg|gif|png|webp|svg|ico|woff2?)$ {
        expires 7d;
        access_log off;
    }
{{- end}}
{{end}}
}

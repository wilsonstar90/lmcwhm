# Generated by lmcwhm — do not edit; changes are overwritten on every apply.
global
    log stdout format raw local0 notice
    stats socket {{.Dir}}/run/admin.sock mode 600 level admin expose-fd listeners
    maxconn 20000
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
    tune.ssl.default-dh-param 2048

defaults
    log global
    option dontlognull
    timeout connect 5s
    timeout client  60s
    timeout server  300s
    timeout http-request 15s
    timeout tunnel  1h

# ---- :443 — route on the TLS ClientHello SNI ----
# sni_exact.map / sni_wild.map name the backend of every hostname: be_pass_N
# forwards the stream untouched (TLS ends at the backend), be_terminate ends
# TLS below with the certificates in crt-list.txt. Exact names win over
# wildcards (".a.com" = "*.a.com", longest first); unknown names terminate.
frontend fe_sni
    mode tcp
    bind 0.0.0.0:443
{{- if .IPv6}}
    bind :::443 v6only
{{- end}}
    tcp-request inspect-delay 5s
    # set-var must precede accept, which ends tcp-request content evaluation.
    tcp-request content set-var(txn.sni) req.ssl_sni,lower,map_str({{.Dir}}/maps/sni_exact.map)
    tcp-request content set-var(txn.sni) req.ssl_sni,lower,map_end({{.Dir}}/maps/sni_wild.map) if !{ var(txn.sni) -m found }
    tcp-request content accept if { req.ssl_hello_type 1 }
    use_backend %[var(txn.sni)] if { var(txn.sni) -m found }
    default_backend be_terminate

backend be_terminate
    mode tcp
    server terminate abns@lmcwhm_https send-proxy-v2
{{range .Passthrough}}
backend {{.Backend}}
    mode tcp
    server s1 {{.Target}}{{if .ProxyProtocol}} send-proxy-v2{{end}}
{{end}}
frontend fe_https
    mode http
    bind abns@lmcwhm_https accept-proxy ssl crt-list {{.Dir}}/crt-list.txt alpn h2,http/1.1
    option forwardfor
{{- if .Body}}
    option http-buffer-request
{{- end}}
{{- template "guard" .}}
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Port 443
    http-request set-var(txn.hsts) var(txn.host),map_str({{.Dir}}/maps/hsts_exact.map)
    http-request set-var(txn.hsts) var(txn.host),map_end({{.Dir}}/maps/hsts_wild.map) if !{ var(txn.hsts) -m found }
    http-response set-header Strict-Transport-Security "max-age=31536000" if { var(txn.hsts) -m str 1 }
    http-request set-var(txn.cache) var(txn.host),map_str({{.Dir}}/maps/cache_exact.map)
    http-request set-var(txn.cache) var(txn.host),map_end({{.Dir}}/maps/cache_wild.map) if !{ var(txn.cache) -m found }
    # HTTP-01 validators follow redirects to HTTPS (e.g. Cloudflare "Always Use HTTPS").
    use_backend be_acme if acme
    use_backend be_web if blocked
    use_backend be_varnish if { var(txn.cache) -m str 1 }
    default_backend be_web

# ---- :80 — ACME HTTP-01, HTTPS redirects, plain HTTP sites ----
frontend fe_http
    mode http
    bind 0.0.0.0:80
{{- if .IPv6}}
    bind :::80 v6only
{{- end}}
    option forwardfor
{{- if .Body}}
    option http-buffer-request
{{- end}}
    http-request set-header X-Forwarded-Proto http
    http-request set-header X-Forwarded-Port 80
{{- template "guard" .}}
    http-request set-var(txn.fh) var(txn.host),map_str({{.Dir}}/maps/force_https_exact.map)
    http-request set-var(txn.fh) var(txn.host),map_end({{.Dir}}/maps/force_https_wild.map) if !{ var(txn.fh) -m found }
    http-request redirect scheme https code 301 if !acme { var(txn.fh) -m str 1 }
    http-request set-var(txn.cache) var(txn.host),map_str({{.Dir}}/maps/cache_exact.map)
    http-request set-var(txn.cache) var(txn.host),map_end({{.Dir}}/maps/cache_wild.map) if !{ var(txn.cache) -m found }
    use_backend be_acme if acme
    use_backend be_web if blocked
    use_backend be_varnish if { var(txn.cache) -m str 1 }
    default_backend be_web

backend be_acme
    mode http
    server panel 127.0.0.1:{{.ACMEPort}}

backend be_web
    mode http
    server nginx 127.0.0.1:{{.NginxPort}}

# Page cache (sites with Varnish on); Varnish fetches misses from nginx.
backend be_varnish
    mode http
    server varnish 127.0.0.1:{{.VarnishPort}}

# Requests per visitor address (CC protection).
backend st_cc
    stick-table type ipv6 size 1m expire 60s store http_req_rate(10s)

{{define "guard"}}
    acl acme path_beg /.well-known/acme-challenge/
    http-request set-var(txn.host) req.hdr(host),field(1,:),lower
    # Visitor address: only connections from a CDN's ranges may set it.
    acl from_cf src -f {{.Dir}}/maps/cdn_cf.lst
    http-request set-var(txn.via_cf) bool(1) if from_cf
{{- if .CDNHeader}}
    acl from_cdn src -f {{.Dir}}/maps/cdn_custom.lst
    http-request set-var(txn.via_cdn) bool(1) if from_cdn !from_cf
{{- end}}
    http-request set-src req.hdr_ip(CF-Connecting-IP,1) if { var(txn.via_cf) -m bool } { req.hdr(CF-Connecting-IP) -m found }
    http-request del-header CF-Connecting-IP if !{ var(txn.via_cf) -m bool }
{{- if .CDNHeader}}
    http-request set-src req.hdr_ip({{.CDNHeader}},-1) if { var(txn.via_cdn) -m bool } { req.hdr({{.CDNHeader}}) -m found }
{{- end}}
    acl via_cdn var(txn.via_cf) -m bool
    acl via_cdn var(txn.via_cdn) -m bool
    # From here src is the visitor. A block only names its reason (txn.block):
    # nginx refuses the request and logs why, so it is counted per site.
    acl ip_allow src -f {{.Dir}}/lists/allow.lst
    acl trusted src -f {{.Dir}}/lists/trust.lst
    acl blocked var(txn.block) -m found
    # User-Agent / URL lists: an allowed request skips the block lists, the protection and the WAF.
    acl list_pass req.hdr(user-agent) -m sub -i -f {{.Dir}}/maps/ua_allow_contains.lst
    acl list_pass req.hdr(user-agent) -m beg -i -f {{.Dir}}/maps/ua_allow_prefix.lst
    acl list_pass req.hdr(user-agent) -m reg -i -f {{.Dir}}/maps/ua_allow_regex.lst
    acl list_pass url -m sub -i -f {{.Dir}}/maps/url_allow_contains.lst
    acl list_pass path -m beg -i -f {{.Dir}}/maps/url_allow_prefix.lst
    acl list_pass url -m reg -i -f {{.Dir}}/maps/url_allow_regex.lst
    acl list_block req.hdr(user-agent) -m sub -i -f {{.Dir}}/maps/ua_block_contains.lst
    acl list_block req.hdr(user-agent) -m beg -i -f {{.Dir}}/maps/ua_block_prefix.lst
    acl list_block req.hdr(user-agent) -m reg -i -f {{.Dir}}/maps/ua_block_regex.lst
    acl list_block url -m sub -i -f {{.Dir}}/maps/url_block_contains.lst
    acl list_block path -m beg -i -f {{.Dir}}/maps/url_block_prefix.lst
    acl list_block url -m reg -i -f {{.Dir}}/maps/url_block_regex.lst
    http-request del-header X-Lmcwhm-Pass
    http-request del-header X-Lmcwhm-Block
    http-request set-header X-Lmcwhm-Pass 1 if list_pass
    http-request set-var(txn.block) str(ip) if { src -f {{.Dir}}/lists/block.lst } !ip_allow !acme
    http-request set-var(txn.block) str(list) if !blocked list_block !list_pass !acme
    # Website protection: flags per host (",on,fake,idc,crawler,cdn,").
    http-request set-var(txn.prot) var(txn.host),map_str({{.Dir}}/maps/prot_exact.map)
    http-request set-var(txn.prot) var(txn.host),map_end({{.Dir}}/maps/prot_wild.map) if !{ var(txn.prot) -m found }
    acl guard var(txn.prot) -m sub ,on,
    http-request set-var(txn.block) str(cdn_only) if !blocked guard { var(txn.prot) -m sub ,cdn, } !via_cdn !ip_allow !list_pass !acme
    http-request set-var(txn.block) str(fake_spider) if !blocked guard { var(txn.prot) -m sub ,fake, } { req.hdr(user-agent) -m sub -i -f {{.Dir}}/maps/spider_ua.lst } !trusted !ip_allow !list_pass !acme
    http-request set-var(txn.block) str(idc) if !blocked guard { var(txn.prot) -m sub ,idc, } { src -f {{.Dir}}/maps/idc.lst } !trusted !ip_allow !list_pass !acme
    http-request set-var(txn.block) str(crawler) if !blocked guard { var(txn.prot) -m sub ,crawler, } { req.hdr(user-agent) -m sub -i -f {{.Dir}}/maps/crawler_ua.lst } !ip_allow !list_pass !acme
{{- range .Rules}}
{{- $code := .Code}}
{{- range .Lines}}
    http-request set-var(txn.block) str(rule-{{$code}}) if !blocked guard !ip_allow !list_pass !acme {{.}}
{{- end}}
{{- end}}
    # CC: requests per visitor address in 10 seconds, limit per host.
    http-request set-var(txn.cc) var(txn.host),map_str_int({{.Dir}}/maps/cc_exact.map)
    http-request set-var(txn.cc) var(txn.host),map_end_int({{.Dir}}/maps/cc_wild.map) if !{ var(txn.cc) -m found }
    http-request track-sc0 src table st_cc if guard { var(txn.cc) -m found } !trusted !ip_allow !list_pass !acme
    http-request set-var(txn.block) str(cc) if !blocked guard { var(txn.cc) -m found } { sc_http_req_rate(0),sub(txn.cc) gt 0 } !trusted !ip_allow !list_pass !acme
    http-request set-header X-Lmcwhm-Block %[var(txn.block)] if blocked
{{- end}}

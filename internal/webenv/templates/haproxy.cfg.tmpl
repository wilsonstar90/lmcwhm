# Generated by lmcwhm — do not edit; changes are overwritten on every apply.
global
    log stdout format raw local0 notice
    stats socket {{.Dir}}/run/admin.sock mode 600 level admin expose-fd listeners
    maxconn 20000
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
    tune.ssl.default-dh-param 2048

defaults
    log global
    option dontlognull
    timeout connect 5s
    timeout client  60s
    timeout server  300s
    timeout http-request 15s
    timeout tunnel  1h

# ---- :443 — route on the TLS ClientHello SNI ----
# sni_exact.map / sni_wild.map name the backend of every hostname: be_pass_N
# forwards the stream untouched (TLS ends at the backend), be_terminate ends
# TLS below with the certificates in crt-list.txt. Exact names win over
# wildcards (".a.com" = "*.a.com", longest first); unknown names terminate.
frontend fe_sni
    mode tcp
    bind 0.0.0.0:443
{{- if .IPv6}}
    bind :::443 v6only
{{- end}}
    tcp-request inspect-delay 5s
    # set-var must precede accept, which ends tcp-request content evaluation.
    tcp-request content set-var(txn.sni) req.ssl_sni,lower,map_str({{.Dir}}/maps/sni_exact.map)
    tcp-request content set-var(txn.sni) req.ssl_sni,lower,map_end({{.Dir}}/maps/sni_wild.map) if !{ var(txn.sni) -m found }
    tcp-request content accept if { req.ssl_hello_type 1 }
    use_backend %[var(txn.sni)] if { var(txn.sni) -m found }
    default_backend be_terminate

backend be_terminate
    mode tcp
    server terminate abns@lmcwhm_https send-proxy-v2
{{range .Passthrough}}
backend {{.Backend}}
    mode tcp
    server s1 {{.Target}}{{if .ProxyProtocol}} send-proxy-v2{{end}}
{{end}}
frontend fe_https
    mode http
    bind abns@lmcwhm_https accept-proxy ssl crt-list {{.Dir}}/crt-list.txt alpn h2,http/1.1
    option forwardfor
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Port 443
    http-request set-var(txn.host) req.hdr(host),field(1,:),lower
    http-request set-var(txn.hsts) var(txn.host),map_str({{.Dir}}/maps/hsts_exact.map)
    http-request set-var(txn.hsts) var(txn.host),map_end({{.Dir}}/maps/hsts_wild.map) if !{ var(txn.hsts) -m found }
    http-response set-header Strict-Transport-Security "max-age=31536000" if { var(txn.hsts) -m str 1 }
    # HTTP-01 validators follow redirects to HTTPS (e.g. Cloudflare "Always Use HTTPS").
    use_backend be_acme if { path_beg /.well-known/acme-challenge/ }
    default_backend be_web

# ---- :80 — ACME HTTP-01, HTTPS redirects, plain HTTP sites ----
frontend fe_http
    mode http
    bind 0.0.0.0:80
{{- if .IPv6}}
    bind :::80 v6only
{{- end}}
    option forwardfor
    http-request set-header X-Forwarded-Proto http
    http-request set-header X-Forwarded-Port 80
    acl acme path_beg /.well-known/acme-challenge/
    http-request set-var(txn.host) req.hdr(host),field(1,:),lower
    http-request set-var(txn.fh) var(txn.host),map_str({{.Dir}}/maps/force_https_exact.map)
    http-request set-var(txn.fh) var(txn.host),map_end({{.Dir}}/maps/force_https_wild.map) if !{ var(txn.fh) -m found }
    http-request redirect scheme https code 301 if !acme { var(txn.fh) -m str 1 }
    use_backend be_acme if acme
    default_backend be_web

backend be_acme
    mode http
    server panel 127.0.0.1:{{.ACMEPort}}

backend be_web
    mode http
    server nginx 127.0.0.1:{{.NginxPort}}
